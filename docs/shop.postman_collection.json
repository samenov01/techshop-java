{
  "info": {
    "name": "Shop — неделя 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Список категорий",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Создать категорию",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categories",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Категория Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"categoryId\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Получить категорию",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/categories/{{categoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Изменить категорию",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categories/{{categoryId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Категория Postman обновлённая\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Создать товар",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Тестовая мышь\",\n  \"description\": \"Товар для проверки API\",\n  \"price\": 5000,\n  \"stock\": 8,\n  \"categoryId\": \"{{categoryId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"productId\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Список товаров",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Получить товар",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Изменить товар",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Тестовая мышь\",\n  \"description\": \"Товар для проверки API\",\n  \"price\": 4500,\n  \"stock\": 6,\n  \"categoryId\": \"{{categoryId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Запрет отрицательного остатка",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Тестовая мышь\",\n  \"description\": \"Товар для проверки API\",\n  \"price\": 5000,\n  \"stock\": -1,\n  \"categoryId\": \"{{categoryId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Запрет удаления занятой категории",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/categories/{{categoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Удалить товар",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Удалить категорию",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/categories/{{categoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Удалённый товар не найден",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    }
  ]
}
